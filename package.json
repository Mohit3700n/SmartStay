{
  "name": "smartstay",
  "version": "0.1.0",
  "private": true,
  "main": "desktop-app/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "next build && npm run desktop:prepare",
