{
  "name": "smartstay-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SmartStay desktop app",
  "main": "main.mjs",
  "build": {
    "appId": "com.smartstay.desktop",
    "productName": "SmartStay",
    "electronVersion": "45.3.3",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.mjs"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "app-server",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "../.next/standalone/node_modules",
        "to": "app-server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "SmartStay-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
